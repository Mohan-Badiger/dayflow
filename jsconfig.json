{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./components/*", "./src/components/*"],
      "@/lib/*": ["./src/lib/*", "./lib/*"],
      "@/models/*": ["./src/models/*", "./models/*"],
      "@/store/*": ["./store/*"],
      "@/providers/*": ["./src/providers/*", "./providers/*"]
    }
  },
  "include": ["src", "components", "lib", "models", "store", "providers"],
  "exclude": ["node_modules"]
}
